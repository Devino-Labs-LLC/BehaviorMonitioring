HOST=http://localhost
PORT=3001

# AWS Secrets Manager (set on Elastic Beanstalk only — leave unset for local .env)
# AWS_REGION=us-east-1
# AWS_SECRET_NAME=prod/BmetricsOPC_EB_Server
# AWS_DB_SECRET_NAME=prod/BmetricsOPC_DB

# HTTP hardening (production ALB / Elastic Beanstalk)
# TRUST_PROXY=1 trusts a single ALB hop (default). Set 0 or false for local direct access.
TRUST_PROXY=1
# LOG_SCANNER_REQUESTS=false suppresses routine HTTP 404 request log lines (default).
# Set true temporarily to diagnose scanner traffic in CloudWatch / logs/requests.log.
LOG_SCANNER_REQUESTS=false
# ALLOWED_HOSTS — optional comma-separated hostnames only (no scheme). Leave unset to disable.
# Example production value (do not commit real hostnames here): api.example.com,www.example.com
# ALLOWED_HOSTS=http://localhost

Resend_API_KEY=Your_Resend_API_KEY
Brevo_SMTP_Server=Your_Brevo_SMTP_Server
Brevo_SMTP_Port=Your_Brevo_Port
Brevo_SMTP_Login=Your_Brevo_Login
Brevo_SMTP_Password=Your_Brevo_Password
ClientHost=http://localhost:3000
IN_PROD=false
JWT_SECRET=Your_JWT_Token
JWT_REFRESH_SECRET=Your_JWT_Refresh_Token
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_NAME=bmRefreshToken
NODE_ENV=development
DB_TYPE=mysql
MYSQL_HOST=Your_DB_Host
MYSQL_PORT=Your_DB_Port
MYSQL_USER=root
MYSQL_PASSWORD=Your_DB_Password
MYSQL_DATABASE=BMetrics
BUSINESS_EMAIL=Your_Business_Email
POC_Email=Your_POC_Email